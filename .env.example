# ==============================================================================
# SISTLABUM - Docker & Local Environment Variables Example
# ==============================================================================
# Salin file ini menjadi .env untuk menjalankan sistem via Docker Compose:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# Application
APP_NAME=SISTLABUM
APP_ENV=local
APP_KEY=base64:w6oCVlMI64nU2Pmfg4Zp4LzcQXDC+lPJsZ63sL4wwTQ=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Compose Profiles
# Aktifkan "storage" jika ingin menjalankan MinIO S3 container:
# COMPOSE_PROFILES=storage

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_PORT_HOST=5433
DB_DATABASE=sistlabum
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Cache & Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Object Storage (MinIO S3)
FILESYSTEM_DISK=s3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sistlabum-files
AWS_ENDPOINT=http://minio:9000

# Mail Server (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# UAT Seeding & Staging Safety Guard
UAT_SEED_ENABLED=true
